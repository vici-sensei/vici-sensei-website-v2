---
import RoadmapCard from './RoadmapCard.astro';
import { roadmapItems } from '../data/roadmap';
---

<section id="roadmap" class="section-padding bg-[#090d16]">
  <div class="container-narrow">
    <div class="header-center">
      <span class="badge">THE ORIGIN STORY</span>
      <h2 class="main-title">My 16-Year Journey</h2>
      <p class="subtitle">The story of a passionate anime fan who chased his dreams, became fluent in Japanese, and now helps others do the same.</p>
    </div>

    <div class="glow-timeline">
      <div class="timeline-line"></div>
      {roadmapItems.map((item) => <RoadmapCard {...item} />)}
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.roadmap-card:not(.pinned-open)');
  cards.forEach((card) => {
    const trigger = card.querySelector('.pill-trigger');
    if (!trigger) return;
    trigger.addEventListener('click', () => {
      const isOpen = card.classList.contains('open');
      cards.forEach((c) => {
        c.classList.remove('open');
        c.querySelector('.pill-trigger')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        card.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
