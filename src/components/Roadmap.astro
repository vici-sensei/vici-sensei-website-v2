---
import RoadmapCard from './RoadmapCard.astro';
import { roadmapItems } from '../data/roadmap';
---

<section id="roadmap" class="section-padding bg-[#090d16]">
  <div class="container-narrow">
    <div class="header-center">
      <span class="badge">THE ORIGIN STORY</span>
      <h2 class="main-title">My 16-Year Journey</h2>
      <p class="subtitle">The story of a passionate anime fan who chased his dreams, became fluent in Japanese, and now helps others do the same.</p>
    </div>

    <div class="glow-timeline">
      <div class="timeline-line"></div>
      {roadmapItems.map((item) => <RoadmapCard {...item} />)}
    </div>
  </div>
</section>

<script>
  const timelineLine = document.querySelector<HTMLElement>('.timeline-line');
  const roadmapCards = document.querySelectorAll<HTMLElement>('.roadmap-card');

  function syncTimelineGradient() {
    if (!timelineLine) return;
    const lineRect = timelineLine.getBoundingClientRect();
    if (!lineRect.height) return;

    const stops: { pct: number; accent: string }[] = [];
    roadmapCards.forEach((card) => {
      const icon = card.querySelector('.card-icon');
      if (!icon) return;
      const accent = getComputedStyle(card).getPropertyValue('--accent-glow').trim();
      const iconRect = icon.getBoundingClientRect();
      const center = iconRect.top + iconRect.height / 2 - lineRect.top;
      const pct = Math.min(100, Math.max(0, (center / lineRect.height) * 100));
      stops.push({ pct, accent });
    });
    if (!stops.length) return;

    stops.sort((a, b) => a.pct - b.pct);
    timelineLine.style.background = `linear-gradient(to bottom, ${stops
      .map((s) => `${s.accent} ${s.pct.toFixed(2)}%`)
      .join(', ')})`;
  }

  let rafId: number | null = null;
  function animateSync(duration = 400) {
    const start = performance.now();
    function step(now: number) {
      syncTimelineGradient();
      if (now - start < duration) {
        rafId = requestAnimationFrame(step);
      }
    }
    if (rafId) cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(step);
  }

  const cards = document.querySelectorAll('.roadmap-card:not(.pinned-open)');
  cards.forEach((card) => {
    const trigger = card.querySelector('.pill-trigger');
    if (!trigger) return;
    trigger.addEventListener('click', () => {
      const isOpen = card.classList.contains('open');
      cards.forEach((c) => {
        c.classList.remove('open');
        c.querySelector('.pill-trigger')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        card.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
      }
      animateSync();
    });
  });

  window.addEventListener('resize', () => syncTimelineGradient());
  window.addEventListener('load', () => syncTimelineGradient());
  syncTimelineGradient();
</script>
