---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  name: string;
  flag: string;
  role: string;
  roleClass?: string;
  quoteTitle?: string;
  quoteTitleOriginal?: string;
  quote: string;
  translated?: boolean;
  quoteOriginal?: string;
  icon: string;
  photo?: ImageMetadata;
  index: number;
}

const {
  name,
  flag,
  role,
  roleClass = 'text-accent-blue',
  quoteTitle,
  quoteTitleOriginal,
  quote,
  translated = false,
  quoteOriginal,
  icon,
  photo,
  index,
} = Astro.props;

// quote/quoteOriginal are plain, unwrapped text (see src/data/testimonials.ts)
// — wrap the first/last paragraph with quote marks here instead, so the
// marks always match the paragraph split. The client-side "see original"
// toggle (in Testimonials.astro) re-applies this same wrapping in Japanese.
const QUOTE_MARKS = { open: '"', close: '"' };
const quoteParagraphs = quote.split('\n\n').map((paragraph, i, all) => {
  let text = paragraph;
  if (i === 0) text = QUOTE_MARKS.open + text;
  if (i === all.length - 1) text += QUOTE_MARKS.close;
  return text;
});
---

<div
  class="testimonial-modal"
  data-index={index}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`testimonialModalName-${index}`}
>
  <button class="testimonial-modal-close" data-close aria-label="Close review" type="button">
    <Icon name="mdi:close" class="h-5 w-5" aria-hidden="true" />
  </button>
  <div class="flex items-center gap-[14px]">
    {
      photo ? (
        <Image src={photo} alt={name} width={96} height={96} class="testimonial-avatar-photo" />
      ) : (
        <div class="testimonial-avatar-fallback">
          <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
        </div>
      )
    }
    <div>
      <h4 class="flex items-center gap-1.5 text-[1.05rem] font-bold text-white" id={`testimonialModalName-${index}`}>
        {name} <Icon name={flag} class="h-4 w-5 rounded-[3px]" aria-hidden="true" />
      </h4>
      <p class={`text-[0.85rem] font-semibold ${roleClass}`}>{role}</p>
    </div>
  </div>
  <div class="flex items-center gap-1 mt-2" aria-label="5 out of 5 stars">
    {
      Array.from({ length: 5 }).map(() => (
        <Icon name="mdi:star" class="h-[18px] w-[18px] text-accent-gold" aria-hidden="true" />
      ))
    }
    <span class="ml-1.5 text-[0.85rem] font-bold text-text-muted">5.0/5.0</span>
  </div>
  <div class="quote-block flex flex-col">
    {
      translated && (
        <span class="mt-8 flex flex-wrap items-center justify-between gap-x-2 gap-y-0.5 text-[0.75rem] text-white/25">
          <span class="translated-label">(Translated from Japanese)</span>
          <button
            type="button"
            class="see-original-btn mb-2 shrink-0 cursor-pointer bg-transparent p-0 font-bold text-white/25 hover:text-white/30 hover:underline"
            data-state="translated"
          >
            see original
          </button>
        </span>
      )
    }
    {
      quoteTitle && (
        <p class="testimonial-quote-title-modal text-[0.95rem]">
          <span class="quote-title-text" data-translated={quoteTitle} data-original={quoteTitleOriginal}>
            {quoteTitle}
          </span>
        </p>
      )
    }
    <div
      class="quote-paragraphs text-[1rem] leading-[1.6] text-text-muted italic"
      data-translated={quote}
      data-original={quoteOriginal}
    >
      {quoteParagraphs.map((paragraph) => <p class="testimonial-quote-para">{paragraph}</p>)}
    </div>
  </div>
</div>
