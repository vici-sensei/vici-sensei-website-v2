<script>
  const methodCards = document.querySelectorAll('.method-card');
  const roadmapCards = document.querySelectorAll('.roadmap-card');
  // Real mouse with hover, not a touch/mobile device — avoids iOS's "sticky hover on tap" quirk.
  const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  // How far past a card's edge the mouse can be and still count as "hovering" it —
  // bridges the small gaps between cards so the glow doesn't drop out between them.
  const hoverBridge = 48;

  function setGlow(elements, activeElement) {
    elements.forEach((element) => {
      element.classList.toggle('active-glow', element === activeElement);
    });
  }

  function nearestWithinBridge(elements, clientX, clientY) {
    let nearestElement = null;
    let nearestDistance = Infinity;

    elements.forEach((element) => {
      const rect = element.getBoundingClientRect();
      const dx = clientX < rect.left ? rect.left - clientX : clientX > rect.right ? clientX - rect.right : 0;
      const dy = clientY < rect.top ? rect.top - clientY : clientY > rect.bottom ? clientY - rect.bottom : 0;
      const distance = Math.hypot(dx, dy);

      if (distance < nearestDistance) {
        nearestDistance = distance;
        nearestElement = element;
      }
    });

    return nearestDistance <= hoverBridge ? nearestElement : null;
  }

  // --- Roadmap cards: glow follows scroll position (or mouse hover on desktop), one at a time. ---
  let hoveredRoadmapElement = null;

  function updateRoadmapFromScroll() {
    if (hoveredRoadmapElement) return; // hovered card takes priority over scroll position

    const screenCenter = window.innerHeight / 2;
    const detectionTolerance = 150;

    let closestElement = null;
    let closestDistance = Infinity;

    roadmapCards.forEach((element) => {
      const rect = element.getBoundingClientRect();
      const elementCenter = rect.top + rect.height / 2;
      const distanceFromCenter = Math.abs(elementCenter - screenCenter);

      if (distanceFromCenter < detectionTolerance && distanceFromCenter < closestDistance) {
        closestDistance = distanceFromCenter;
        closestElement = element;
      }
    });

    setGlow(roadmapCards, closestElement);
  }

  // --- Pillar (method) cards: desktop glows on mouse hover only; touch glows every
  // card currently crossing the screen's vertical center, so more than one can light up at once. ---
  function updateMethodCardsForTouch() {
    const screenCenter = window.innerHeight / 2;

    methodCards.forEach((card) => {
      const rect = card.getBoundingClientRect();
      const touchesCenter = rect.top <= screenCenter && rect.bottom >= screenCenter;
      card.classList.toggle('active-glow', touchesCenter);
    });
  }

  if (supportsHover) {
    let lastX = 0;
    let lastY = 0;
    let rafPending = false;
    let hoveredMethodElement = null;

    function updateHover(clientX, clientY) {
      const newHoveredRoadmap = nearestWithinBridge(roadmapCards, clientX, clientY);
      if (newHoveredRoadmap !== hoveredRoadmapElement) {
        hoveredRoadmapElement = newHoveredRoadmap;
        if (hoveredRoadmapElement) {
          setGlow(roadmapCards, hoveredRoadmapElement);
        } else {
          updateRoadmapFromScroll();
        }
      }

      const newHoveredMethod = nearestWithinBridge(methodCards, clientX, clientY);
      if (newHoveredMethod !== hoveredMethodElement) {
        hoveredMethodElement = newHoveredMethod;
        setGlow(methodCards, hoveredMethodElement);
      }
    }

    window.addEventListener(
      'mousemove',
      (event) => {
        lastX = event.clientX;
        lastY = event.clientY;
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(() => {
          rafPending = false;
          updateHover(lastX, lastY);
        });
      },
      { passive: true }
    );

    document.documentElement.addEventListener('mouseleave', () => {
      hoveredRoadmapElement = null;
      updateRoadmapFromScroll();
      hoveredMethodElement = null;
      setGlow(methodCards, null);
    });
  } else {
    updateMethodCardsForTouch();
    window.addEventListener('touchmove', updateMethodCardsForTouch, { passive: true });
    window.addEventListener('touchend', updateMethodCardsForTouch, { passive: true });
  }

  window.addEventListener('scroll', () => {
    updateRoadmapFromScroll();
    if (!supportsHover) updateMethodCardsForTouch();
  }, { passive: true });
  window.addEventListener('touchmove', updateRoadmapFromScroll, { passive: true });
  window.addEventListener('touchend', updateRoadmapFromScroll, { passive: true });
  window.addEventListener('resize', () => {
    updateRoadmapFromScroll();
    if (!supportsHover) updateMethodCardsForTouch();
  });
  updateRoadmapFromScroll();
</script>
